<Window x:Class="testCam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:testCam"
        mc:Ignorable="d"
        Title="testCam" Height="540" Width="1000" 
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <!-- 💡 수정 1: 음수 마진(-490, -272)을 제거하고 표준 여백(12)으로 변경 -->
    <Grid Background="GhostWhite" Margin="12">
        <Grid.ColumnDefinitions>
            <!-- 좌측: 설정 패널 (고정폭 280px) -->
            <ColumnDefinition Width="280"/>
            <!-- 우측: 카메라 영상 영역 (남은 가로 공간 전부 차지) -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= 좌측: 설정 및 ROI 색상 확인 ================= -->
        <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="14" Margin="0,0,12,0"
                BorderBrush="#D0D0D0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="인식 영역(ROI) 설정" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <TextBlock Text="우측 영상 위를 마우스로 드래그하여 인식할 ROI 영역을 지정하세요." 
                           TextWrapping="Wrap" Foreground="#555555" FontSize="12" Margin="0,0,0,16"/>

                <TextBlock Text="추출된 평균 색상" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>

                <Rectangle x:Name="colorSwatch" Width="80" Height="80" 
                           Stroke="#B0B0B0" StrokeThickness="1" Fill="White" 
                           HorizontalAlignment="Left" RadiusX="4" RadiusY="4"/>

                <TextBlock x:Name="colorText" Text="RGB(0, 0, 0)" 
                           Margin="0,8,0,0" FontFamily="Consolas" FontSize="12" Foreground="#333333"/>
            </StackPanel>
        </Border>

        <!-- ================= 우측: 카메라 뷰어 영역 ================= -->
        <!-- 💡 수정 2: ClipToBounds="True"로 영상이 테두리 밖으로 삐져나가는 현상 방지 -->
        <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="6" ClipToBounds="True">
            <Grid>
                <!-- Stretch="Uniform"이 적용되어 창 크기에 맞춰 16:9 비율을 유지하며 100% 온전하게 표시됩니다 -->
                <Image x:Name="cameraImage" Stretch="Uniform" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- 영상 좌상단 상태 텍스트 오버레이 -->
                <TextBlock x:Name="statusText" Foreground="Yellow" Margin="10" 
                           VerticalAlignment="Top" HorizontalAlignment="Left"
                           FontFamily="Consolas" FontSize="12"/>
            </Grid>
        </Border>

    </Grid>
</Window>