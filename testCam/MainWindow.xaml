<Window x:Class="testCam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:testCam"
        mc:Ignorable="d"
        Title="testCam" Height="600" Width="900">
    <Grid Background="Black">
        <Image x:Name="cameraImage" Stretch="Uniform"/>
        <TextBlock x:Name="statusText" Foreground="White" Margin="8" VerticalAlignment="Top"/>
    </Grid>
</Window>
